set(CMAKE_SYSTEM_NAME Generic)

find_program(_XTENSA_ESP_GCC xtensa-esp-elf-gcc)
if(_XTENSA_ESP_GCC)
    set(_XTENSA_PREFIX "xtensa-esp-elf-")
    get_filename_component(_XTENSA_BIN_DIR "${_XTENSA_ESP_GCC}" DIRECTORY)
    get_filename_component(_XTENSA_ROOT_DIR "${_XTENSA_BIN_DIR}" DIRECTORY)
    set(_XTENSA_LIB_DIR "${_XTENSA_ROOT_DIR}/lib")
    set(_XTENSA_DYNCONFIG "${_XTENSA_LIB_DIR}/xtensa_esp8266.so")
    if(EXISTS "${_XTENSA_DYNCONFIG}")
        set(ENV{XTENSA_GNU_CONFIG} "${_XTENSA_DYNCONFIG}")
        string(FIND "$ENV{PATH}" "${_XTENSA_LIB_DIR}" _has_xtensa_lib)
        if(_has_xtensa_lib EQUAL -1)
            set(ENV{PATH} "${_XTENSA_LIB_DIR};$ENV{PATH}")
        endif()
    endif()
    set(_XTENSA_DYN_FLAG " -mdynconfig=xtensa_esp8266.so")
    set(_XTENSA_LD_EXTRA " -mdynconfig=xtensa_esp8266.so -Wl,--no-warn-rwx-segments")
else()
    set(_XTENSA_PREFIX "xtensa-lx106-elf-")
    set(_XTENSA_DYN_FLAG "")
    set(_XTENSA_LD_EXTRA "")
endif()

set(CMAKE_C_COMPILER ${_XTENSA_PREFIX}gcc)
set(CMAKE_CXX_COMPILER ${_XTENSA_PREFIX}g++)
set(CMAKE_ASM_COMPILER ${_XTENSA_PREFIX}gcc)

set(CMAKE_C_FLAGS "-mlongcalls -Wno-frame-address${_XTENSA_DYN_FLAG}" CACHE STRING "C Compiler Base Flags")
set(CMAKE_CXX_FLAGS "-mlongcalls -Wno-frame-address${_XTENSA_DYN_FLAG}" CACHE STRING "C++ Compiler Base Flags")
set(CMAKE_ASM_FLAGS "-mlongcalls${_XTENSA_DYN_FLAG}" CACHE STRING "ASM Compiler Base Flags")

# Can be removed after gcc 5.2.0 support is removed (ref GCC_NOT_5_2_0)
set(CMAKE_EXE_LINKER_FLAGS "-nostdlib -Wl,--gc-sections${_XTENSA_LD_EXTRA}" CACHE STRING "Linker Base Flags")
