[mapping:esp8266]
archive: libesp8266.a
entries:
    if ESP8266_CORE_GLOBAL_DATA_LINK_IRAM = y:
        if ESP8266_OSS_CORE = y:
            esp_misc_nvs (iram_bss)
            esp_ets_timer (iram_bss)
            esp_misc (iram_bss)
            esp_sys_ctrl (iram_bss)
        esp_sleep (iram_bss)
        reset_reason (iram_bss)
        task_wdt (iram_bss)

[mapping:pp]
archive: libpp.a
entries:
    if ESP8266_VENDOR_PHY_WIFI = y:
        if ESP8266_WIFI_DEBUG_LOG_ENABLE = n:
            * (noflash_text)

[mapping:pp_dbg]
archive: libpp_dbg.a
entries:
    if ESP8266_VENDOR_PHY_WIFI = y:
        if ESP8266_WIFI_DEBUG_LOG_ENABLE = y:
            * (noflash_text)

[mapping:phy]
archive: libphy.a
entries:
    if ESP8266_VENDOR_PHY_WIFI = y:
        * (noflash_text)

[mapping:core]
archive: libcore.a
entries:
    if ESP8266_VENDOR_CORE = y:
        if ESP8266_WIFI_DEBUG_LOG_ENABLE = n:
            if ESP8266_CORE_GLOBAL_DATA_LINK_IRAM = y:
                * (iram_bss)

[mapping:core_dbg]
archive: libcore_dbg.a
entries:
    if ESP8266_VENDOR_CORE = y:
        if ESP8266_WIFI_DEBUG_LOG_ENABLE = y:
            if ESP8266_CORE_GLOBAL_DATA_LINK_IRAM = y:
                * (iram_bss)

[mapping:gcc]
archive: libgcc_romstrip.a
entries:
    unwind-dw2 (inflash_text)
    unwind-dw2-fde (inflash_text)
    unwind-c (inflash_text)
    emutls (inflash_text)
    hardcfr (inflash_text)
    strub (inflash_text)
    _mulsf3 (inflash_text)
    _divsf3 (inflash_text)
    _cmpsf2 (inflash_text)
    _fixsfsi (inflash_text)
    _fixsfdi (inflash_text)
    _fixunssfdi (inflash_text)
    _floatdisf (inflash_text)
    _cmpdf2 (inflash_text)
    _fixdfdi (inflash_text)
    _fixunsdfdi (inflash_text)
    _floatdidf (inflash_text)
    _powisf2 (inflash_text)
    _powidf2 (inflash_text)
    _mulsc3 (inflash_text)
    _muldc3 (inflash_text)
    _divsc3 (inflash_text)
    _divdc3 (inflash_text)
    _moddi3 (inflash_text)
    _popcountsi2 (inflash_text)

[mapping:c]
archive: libc.a
entries:
    * (inflash_text)

[mapping:c_nano]
archive: libc_nano.a
entries:
    * (inflash_text)

[mapping:m]
archive: libm.a
entries:
    * (inflash_text)

[mapping:stdcxx]
archive: libstdc++.a
entries:
    * (inflash_text)

[mapping:supcxx]
archive: libsupc++.a
entries:
    * (inflash_text)

[mapping:nosys]
archive: libnosys.a
entries:
    * (inflash_text)

