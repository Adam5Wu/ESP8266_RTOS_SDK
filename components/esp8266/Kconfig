    menu "Open-Source / Vendor Blob Selection"

        config ESP8266_VENDOR_BLOBS
            bool "Allow prebuilt vendor blobs"
            default n
            help
                By default, ESP8266_RTOS_SDK builds 100% from open-source
                implementations with zero prebuilt vendor binary archives linked.

                Enable this option to unlock legacy prebuilt vendor archives in
                components/esp8266/lib/ (HAL, Core/RTC, Wi-Fi, ESP-NOW, and
                SmartConfig).

        choice ESP8266_HAL_IMPL
            prompt "HAL implementation"
            default ESP8266_OSS_HAL
            help
                Select the Xtensa LX106 Call0 Core HAL implementation:

                - Open-source: clean-room components/esp8266/source/xtensa_hal.S.
                - Vendor blob: prebuilt components/esp8266/lib/libhal.a
                  (requires Allow prebuilt vendor blobs).

                Fully ABI-compatible and independently mixable with either
                open-source or vendor Core/Wi-Fi layers.

            config ESP8266_OSS_HAL
                bool "Open-source"
            config ESP8266_VENDOR_HAL
                bool "Vendor blob"
                depends on ESP8266_VENDOR_BLOBS
        endchoice

        choice ESP8266_PHY_WIFI_IMPL
            prompt "Wi-Fi & PHY implementation"
            default ESP8266_OSS_PHY_WIFI
            help
                Select the SoC PHY (BBPLL, RTC PMU/sleep, ROM-I2C/PBUS, SAR ADC)
                and Wi-Fi RF/LMAC/802.11 implementation:

                - Open-source (PHY + Wi-Fi): clean-room components/esp8266/{phy,lmac,net80211}/.
                - Vendor blobs (PHY + Wi-Fi): prebuilt monolithic libphy.a + libpp.a +
                  libnet80211.a (requires Allow prebuilt vendor blobs).
                - Open-source PHY only (no Wi-Fi): clean-room SoC PHY (RTC cali, BBPLL,
                  light/deep sleep, SAR ADC/VDD33) with zero Wi-Fi RF/MAC/802.11 code
                  or Wi-Fi blobs (100% zero-blob when Allow prebuilt vendor blobs is
                  disabled; still mixable with Vendor HAL).

            config ESP8266_OSS_PHY_WIFI
                bool "Open-source (PHY + Wi-Fi)"
            config ESP8266_VENDOR_PHY_WIFI
                bool "Vendor blobs (PHY + Wi-Fi)"
                depends on ESP8266_VENDOR_BLOBS
            config ESP8266_OSS_PHY_ONLY
                bool "Open-source PHY only (no Wi-Fi)"
        endchoice

        config ESP8266_OSS_PHY
            bool
            default y if !ESP8266_VENDOR_PHY_WIFI

        choice ESP8266_CORE_IMPL
            prompt "Core & RTC implementation"
            default ESP8266_OSS_CORE
