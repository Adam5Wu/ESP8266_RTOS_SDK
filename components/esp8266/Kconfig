                Select the SoC Core (ets_timer, misc, misc_nvs, sys_ctrl) and
                RTC/Clock implementation:

                - Open-source: clean-room components/esp8266/source/esp_*.c
                  (compatible with Open-source (PHY + Wi-Fi),
                  Vendor blobs (PHY + Wi-Fi), or Open-source PHY only).
                - Vendor blobs: prebuilt libcore.a + libclk.a + librtc.a
                  (requires Allow prebuilt vendor blobs and
                  Vendor blobs (PHY + Wi-Fi)).

            config ESP8266_OSS_CORE
                bool "Open-source"
            config ESP8266_VENDOR_CORE
                bool "Vendor blobs"
                depends on ESP8266_VENDOR_BLOBS && ESP8266_VENDOR_PHY_WIFI
        endchoice

