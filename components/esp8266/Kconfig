menu "Power Management"
    config PM_ENABLE
        bool "Support for power management"
        default n
        help
            If enabled, application is compiled with support for power management.
            This option has run-time overhead (increased interrupt latency,
            longer time to enter idle state), and it also reduces accuracy of
            RTOS ticks and timers used for timekeeping.
            Enable this option if application uses power management APIs.
endmenu

menu Wi-Fi
    visible if !ESP8266_OSS_PHY_ONLY

config SCAN_AP_MAX
    int "Max scan AP number"
    range 1 100
    default 99
    help
        Maximum number of AP records returned by a Wi-Fi scan.

        - Open-source Wi-Fi: scan result storage is capped at 64 APs
          (net80211_scan.c), even if configured higher.
        - Vendor Wi-Fi: honors values up to 100.

        "esp_wifi_scan_get_ap_num" returns at most this count; users can also
        query "esp_wifi_scan_get_ap_num_max" to determine the configured cap.

config WIFI_TX_RATE_SEQUENCE_FROM_HIGH
    bool "Set WiFi TX rate from 54M to 1M"
    default y
    help
        Configure the initial TX rate policy.

        - Open-source Wi-Fi (lmac_trc.c): y initializes windowed AARF at
          MCS7/54M (clamped on weak < -80 dBm links), and n initializes at
          MCS4/24M.
        - Vendor Wi-Fi: when y, sends packets starting from 54M down to 1M
          until transmission succeeds.

config ESP8266_WIFI_QOS_ENABLED
    bool "WiFi QoS"
    default n
    help
        Select this option to enable QoS feature

config ESP8266_WIFI_AMPDU_RX_ENABLED
    bool "WiFi AMPDU RX"
    select ESP8266_WIFI_QOS_ENABLED
    default n
    help
        Select this option to enable AMPDU RX feature

config ESP8266_WIFI_RX_BA_WIN_SIZE
    int "WiFi AMPDU RX BA window size"
    depends on ESP8266_WIFI_AMPDU_RX_ENABLED
    range 0 16
    default 6
    help
        Set the size of WiFi Block Ack RX window. Generally a bigger value means higher throughput and better
        compatibility but more memory.

config ESP8266_WIFI_AMSDU_ENABLED
    bool "WiFi AMSDU RX"
    depends on ESP8266_VENDOR_PHY_WIFI
    default n
    help
        Select this option to enable AMSDU feature

config ESP8266_WIFI_RX_BUFFER_NUM
    int "Max number of WiFi RX buffers"
    range 14 28
    default 16
    help
        Set the number of Wi-Fi RX buffers.

        - Open-source Wi-Fi (lmac_internal.h, lmac_pm_compat.c): each buffer
          is 524 B in a contiguous DMA arena and the count is capped at 24
          (LMAC_MAX_RX_BUFS).
        - Vendor Wi-Fi: honors up to 28 buffers (each ~524 B; 26 is
          recommended for shieldbox iperf).

        Most applications should keep the default unless tuning peak RX
        throughput.

config ESP8266_WIFI_LEFT_CONTINUOUS_RX_BUFFER_NUM
    int "The min number of WiFi continuous RX buffer"
    range 0 16
    default 16
    help
        Set the continuous RX buffer threshold.

        - Open-source Wi-Fi (net80211_data.c): sets the hybrid zero-copy vs.
          heap-copy RX threshold (free_contiguous > threshold &&
          free_8bit > 6 KB). With defaults 16/16, free_contiguous <= 15 so
          OSS always copies to heap and recycles DMA immediately; lowering
          below RX_BUFFER_NUM - 1 enables zero-copy RX into lwIP.
        - Vendor Wi-Fi: reserves minimum contiguous DMA headroom to prevent
          vendor RX hangs.

config ESP8266_WIFI_RX_PKT_NUM
    int "Max number of WiFi RX packets"
    depends on ESP8266_VENDOR_PHY_WIFI
    range 4 16
    default 7
    help
        Set the max number of signle WiFi packet.

config ESP8266_WIFI_TX_PKT_NUM
    int "Max number of WiFi TX packets"
    range 4 16
    default 6
    help
        Set the number of Wi-Fi TX slots/packets.

        - Open-source Wi-Fi (lmac_tx.c): TX slots are scatter-gather DMA
          descriptors (~216 B/slot default, ~188 B/slot with
          ESP8266_OSS_WIFI_MIN_NMI=y, not 1.6 KB/buffer) and the pool is
          floored at 10 slots when ESP8266_OSS_WIFI_MIN_NMI=n (values 4..9
          apply only when ESP8266_OSS_WIFI_MIN_NMI=y).
        - Vendor Wi-Fi: each buffer consumes ~1.6 KB of RAM; increase for
          bursty UDP traffic.

config ESP8266_WIFI_NVS_ENABLED
    bool "WiFi NVS flash"
    default y
    help
        Select this option to enable WiFi NVS flash.

        Under Open-source Wi-Fi, disabling NVS (n) causes
        ESP8266_OSS_WIFI_RTC_FAST_CONNECT to default to y.

config ESP8266_WIFI_CONNECT_OPEN_ROUTER_WHEN_PWD_IS_SET
    bool "Connect open router when wifi password is set"
    default y
    help
        When this option is enabled, ESP8266 will connect to open router even if wifi password is set, otherwise 
        ESP8266 will not connect to open router when wifi password is set.

config ESP8266_WIFI_ENABLE_WPA3_SAE
    bool "Enable WPA3-Personal"
    default y
    help
        Select this option to allow the device to establish a WPA3-Personal connection with eligible AP's.
        PMF (Protected Management Frames) is a prerequisite feature for a WPA3 connection, it needs to be
        explicitly configured before attempting connection. Please refer to the Wi-Fi Driver API Guide for details.

config ESP8266_OSS_WIFI_MIN_NMI
    bool "Minimal IRAM NMI handler"
    depends on ESP8266_OSS_PHY_WIFI
    default n
    help
        Disable the IRAM Level-3 NMI fast TX retry/launch path in
        lmac_nmi.c (wDev_ProcessFiq).

        By default (n), retryable TX completions and queued TX launches
        execute directly in IRAM NMI so TX continues uninterrupted across
        SPI flash erase/read cache-off windows (+708 B IRAM, still ~50%
        less IRAM than vendor blobs).

        Enable (y) to defer all TX handling to the flash-resident Wi-Fi
        worker task and reclaim those 708 B of static IRAM.

config ESP8266_OSS_WIFI_TASK_PRIO
    int "OSS Wi-Fi worker task priority"
    depends on ESP8266_OSS_PHY_WIFI
    range 1 14
    default 13
    help
        FreeRTOS priority for the unified open-source Wi-Fi worker task (1..14).
        Defaults to 13 (below the configMAX_PRIORITIES-1 = 14 ceiling) so the
        worker runs above tcpip/application tasks while preserving one headroom
        slot for urgent system tasks.

config ESP8266_OSS_WIFI_RTC_FAST_CONNECT
    bool "Cache STA PMK and channel in RTC_SYS across warm resets"
    depends on ESP8266_OSS_PHY_WIFI
    default y if !ESP8266_WIFI_NVS_ENABLED
    default n
    help
        Cache the derived 32-byte WPA2 PMK, BSSID, and channel in 64 bytes of
        RTC_SYS memory so warm resets / OTA reboots skip PBKDF2-SHA1 and probe
        the cached channel first. Cleared automatically on power-on reset.

